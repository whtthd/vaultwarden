# Local development only. Copy to .env; keep runtime data under data/dev.
DOMAIN=https://127.0.0.1:8001
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8001
ROCKET_TLS='{certs="data/dev/tls/localhost.pem",key="data/dev/tls/localhost-key.pem"}'

DATA_FOLDER=data/dev
DATABASE_URL=sqlite://data/dev/db.sqlite3
# Keep imported snapshots stable during local debugging.
JOB_POLL_INTERVAL_MS=0

WEB_VAULT_ENABLED=true
WEB_VAULT_FOLDER=web-vault/
RELOAD_TEMPLATES=true

LOG_LEVEL=debug
LOG_FILE=data/dev/vaultwarden.log
RUST_BACKTRACE=1
SMTP_DEBUG=false
SSO_DEBUG_TOKENS=false

SIGNUPS_ALLOWED=true
# Set a locally generated Argon2 hash to enable /admin:
# ADMIN_TOKEN='$argon2id$...'
